cc_defaults {
    name: "external_canutils_defaults",
    local_include_dirs: ["include/"],
    cflags: [
        "-O2",
        "-g",
        "-W",
        "-Wall",
        "-DSO_RXQ_OVFL=40",
        "-DPF_CAN=29",
        "-DAF_CAN=PF_CAN",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-pointer-arith",
        "-Wno-address-of-packed-member",
        "-Wno-absolute-value",
    ],
    vendor: true,
}


// canlib
cc_library_static {
    name: "libcan",
    defaults: ["external_canutils_defaults"],

    srcs: [
        "lib.c",
        "canframelen.c",
    ],
}

// candump
cc_binary {
    name: "candump",
    defaults: ["external_canutils_defaults"],

    srcs: ["candump.c"],

    static_libs: ["libcan"],
}

// cansend
cc_binary {
    name: "cansend",
    defaults: ["external_canutils_defaults"],

    srcs: ["cansend.c"],

    static_libs: ["libcan"],
}

